{
  "expo": {
    "name": "味笺",
    "slug": "food-ledger",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "foodledger",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E8D5B0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foodledger.app",
      "infoPlist": {
        "NSCameraUsageDescription": "用于拍摄美食照片记录",
        "NSPhotoLibraryUsageDescription": "用于选择美食照片记录",
        "NSLocationWhenInUseUsageDescription": "用于记录用餐地点足迹"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E8D5B0"
      },
      "package": "com.foodledger.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        { "enableFTS": true }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许访问相册以选择美食照片",
          "cameraPermission": "允许访问相机以拍摄美食照片"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "允许获取位置以记录用餐地点。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
